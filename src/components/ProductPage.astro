---
import PageLayout from "../layouts/PageLayout.astro";
import Breadcrumb from "./Breadcrumb.astro";
import LineCta from "./LineCta.astro";
import { LINE_URL } from "../data/site";
import { withBase } from "../lib/links";
import {
  CONSULT_SHIPPING,
  PAYMENT_METHODS,
  type Plan,
} from "../data/pricing";
import type { Product } from "../data/products";
import {
  getPlansForProduct,
  getProductBySlug,
  productHref,
} from "../data/products";

export interface Props {
  product: Product;
}

const { product } = Astro.props;
const plans = getPlansForProduct(product);
const steps = product.steps ?? [];
const accent = product.accent;

const related =
  product.relatedSlugs
    ?.map((slug) => getProductBySlug(product.category, slug))
    .filter((p): p is Product => p != null) ?? [];

const breadcrumbs = [
  { label: "ホーム", href: "/" },
  { label: product.categoryLabel, href: product.categoryHref },
  { label: product.name },
];

type PriceTerm = "buyout" | "m1" | "m3" | "m6";
interface PriceCell {
  single?: number;
  initial?: number | null;
  recur?: number | null;
}

const priceTerms: PriceTerm[] = ["buyout", "m1", "m3", "m6"];

function getPriceCell(plan: Plan, term: PriceTerm): PriceCell | null {
  if (term === "buyout") {
    return plan.buyout != null ? { single: plan.buyout } : null;
  }
  const t = plan[term];
  return !t || (t.initial == null && t.recur == null)
    ? null
    : { initial: t.initial, recur: t.recur };
}
---

<PageLayout title={product.metaTitle} description={product.metaDescription}>
  <Breadcrumb items={breadcrumbs} />

  {/* HERO */}
  <section class={`p-hero p-hero--${accent}`}>
    <div class="container p-hero-inner">
      <div class="p-hero-copy">
        <p class="p-eyebrow">{product.heroEyebrow}</p>
        <h1 class="p-hero-title">
          {product.heroTitle}<br />
          <span class="p-hero-accent">{product.heroAccent}</span>
        </h1>
        <p class="p-hero-lead">{product.heroLead}</p>
        <ul class="p-hero-badges">
          {product.heroBadges.map((b) => (
            <li><i class="fa-solid fa-circle-check" aria-hidden="true"></i>{b}</li>
          ))}
        </ul>
        <div class="p-hero-actions">
          <a class="btn btn--line" href={LINE_URL} target="_blank" rel="noopener">
            <i class="fa-brands fa-line" aria-hidden="true"></i>LINEで無料相談
          </a>
          <a class="btn btn--ghost" href="#pricing">料金を見る</a>
        </div>
      </div>
      {product.heroStats && (
        <div class="p-hero-stats" aria-hidden="true">
          {product.heroStats.map((s, i) => (
            <>
              {i > 0 && <div class="p-stat-div" />}
              <div>
                <strong>{s.value}<span>{s.unit}</span></strong>
                <small>{s.label}</small>
              </div>
            </>
          ))}
        </div>
      )}
    </div>
  </section>

  {/* WHAT IS */}
  <section class="section" id="about">
    <div class="container container--narrow">
      <header class="section-head">
        <p class="eyebrow">ABOUT</p>
        <h2 class="section-title">{product.whatIsTitle}</h2>
      </header>
      <div class="p-prose">
        {product.whatIs.map((para) => <p>{para}</p>)}
      </div>
    </div>
  </section>

  {/* MECHANISM */}
  {product.mechanism && product.mechanism.length > 0 && (
    <section class="section section--cream" id="mechanism">
      <div class="container">
        <header class="section-head">
          <p class="eyebrow">MECHANISM</p>
          <h2 class="section-title">作用の<span class="accent">しくみ</span></h2>
        </header>
        <div class="p-mech-grid">
          {product.mechanism.map((m, i) => (
            <article class="p-mech-card">
              <span class="p-mech-no">0{i + 1}</span>
              <span class="p-mech-icon"><i class={`fa-solid ${m.icon}`} aria-hidden="true"></i></span>
              <h3>{m.title}</h3>
              <p>{m.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* FOR WHOM */}
  <section class="section" id="for-whom">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">FOR YOU</p>
        <h2 class="section-title">こんな方に<span class="accent">おすすめ</span></h2>
      </header>
      <div class="p-for-grid">
        {product.forWhom.map((f) => (
          <article class="p-for-card">
            <span class="p-for-icon"><i class={`fa-solid ${f.icon}`} aria-hidden="true"></i></span>
            <div>
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="p-not-for">
        <h3><i class="fa-solid fa-ban" aria-hidden="true"></i>向いていない方・処方できない方</h3>
        <ul>
          {product.notFor.map((n) => (
            <li><i class="fa-solid fa-xmark" aria-hidden="true"></i><span>{n}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* PRICING */}
  <section class="section section--cream" id="pricing">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">PRICING</p>
        <h2 class="section-title">料金<span class="accent">プラン</span></h2>
        <p class="lead">すべて税込・別途診察・配送料 ¥{CONSULT_SHIPPING.toLocaleString()}・定期縛りなし</p>
      </header>
      {product.dosage && (
        <div class="p-dosage">
          <h3><i class="fa-solid fa-pills" aria-hidden="true"></i>用法・用量</h3>
          <p>{product.dosage}</p>
        </div>
      )}
      <div class="table-scroll" tabindex="0" role="region" aria-label={`${product.name}の料金表`}>
        <table class="price-table">
          <thead>
            <tr>
              <th class="col-drug">プラン名</th>
              <th>買い切り</th>
              <th>1ヶ月定期</th>
              <th>3ヶ月定期</th>
              <th>6ヶ月定期</th>
            </tr>
          </thead>
          <tbody>
            {plans.map((p) => (
              <tr>
                <td class="drug-cell">
                  <span class="drug-name">{p.name}</span>
                  {p.detail && <span class="drug-detail">{p.detail}</span>}
                  {p.note && <span class="drug-note">{p.note}</span>}
                </td>
                {priceTerms.map((term) => {
                  const price = getPriceCell(p, term);
                  return (
                    <td class="price-cell">
                      {!price ? (
                        "—"
                      ) : price.single != null ? (
                        `¥${price.single.toLocaleString()}`
                      ) : (
                        <>
                          {price.initial != null && (
                            <span class="term-initial">初回 ¥{price.initial.toLocaleString()}</span>
                          )}
                          {price.recur != null && (
                            <span class="term-recur">2回目以降 ¥{price.recur.toLocaleString()}</span>
                          )}
                        </>
                      )}
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="p-payment">
        <h3><i class="fa-solid fa-credit-card" aria-hidden="true"></i>お支払い方法</h3>
        <p>{PAYMENT_METHODS}</p>
        <p class="p-payment-note">※診察・配送料は初回・2回目以降ともに一律 ¥{CONSULT_SHIPPING.toLocaleString()}（税込）</p>
      </div>
    </div>
  </section>

  {/* FLOW */}
  {steps.length > 0 && (
    <section class="section" id="flow">
      <div class="container">
        <header class="section-head">
          <p class="eyebrow">FLOW</p>
          <h2 class="section-title">ご利用の<span class="accent">流れ</span></h2>
        </header>
        <ol class="p-steps">
          {steps.map((s) => (
            <li class="p-step">
              <span class="p-step-no">{s.no}</span>
              <div>
                <div class="p-step-head">
                  <h3>{s.title}</h3>
                  <span class="p-step-time">{s.time}</span>
                </div>
                <p>{s.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {/* SIDE EFFECTS */}
  <section class="section section--cream" id="caution">
    <div class="container container--narrow">
      <header class="section-head">
        <p class="eyebrow">CAUTION</p>
        <h2 class="section-title">副作用・<span class="accent">注意事項</span></h2>
      </header>
      <ul class="p-caution-list">
        {product.sideEffects.map((s) => (
          <li><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i><span>{s}</span></li>
        ))}
      </ul>
      <h3 class="p-contra-title"><i class="fa-solid fa-ban" aria-hidden="true"></i>主な禁忌</h3>
      <ul class="p-contra-list">
        {product.contraindications.map((c) => (
          <li><i class="fa-solid fa-xmark" aria-hidden="true"></i><span>{c}</span></li>
        ))}
      </ul>
    </div>
  </section>

  {/* FAQ */}
  <section class="section" id="faq">
    <div class="container container--narrow">
      <header class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2 class="section-title">よくある<span class="accent">質問</span></h2>
      </header>
      <div class="p-faq-list">
        {product.faq.map((item) => (
          <details class="p-faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* RELATED */}
  {related.length > 0 && (
    <section class="section section--cream" id="related">
      <div class="container">
        <header class="section-head">
          <p class="eyebrow">RELATED</p>
          <h2 class="section-title">関連<span class="accent">商品</span></h2>
        </header>
        <div class="p-related-grid">
          {related.map((r) => (
            <a class="p-related-card" href={withBase(productHref(r.category, r.slug))}>
              <h3>{r.name}</h3>
              <p>{r.heroLead.slice(0, 60)}…</p>
              <span>詳しく見る →</span>
            </a>
          ))}
          <a class="p-related-card p-related-card--cat" href={withBase(product.categoryHref)}>
            <h3>{product.categoryLabel}一覧</h3>
            <p>他の取扱商品・料金プランを見る</p>
            <span>カテゴリページへ →</span>
          </a>
        </div>
      </div>
    </section>
  )}

  {/* DISCLAIMER */}
  <section class="p-disclaimer">
    <div class="container container--narrow">
      <p class="p-disclaimer-title">
        <i class="fa-solid fa-circle-info" aria-hidden="true"></i>免責事項
      </p>
      {product.disclaimer.map((d) => <p>{d}</p>)}
      <p>
        本サービスは自由診療（保険適用外）です。効果・効能には個人差があり、すべての方に同様の効果を保証するものではありません。
        診察の結果、処方を行えない場合があります。
      </p>
      <p>
        承認状況・入手経路・海外の安全性情報等は<a href={withBase("/legal/medical-ad")}>医療広告ガイドラインについて</a>をご確認ください。
      </p>
    </div>
  </section>

  <LineCta
    heading={`${product.name}のご相談はLINEから`}
    text="問診〜診察〜発送までスマホひとつで完結。まずはお気軽にご相談ください。"
  />
</PageLayout>

<style define:vars={{ accentColor: accent === "gold" ? "var(--gold-700)" : accent === "navy" ? "var(--ink-700)" : "var(--brand-700)" }}>
  .section-head {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto clamp(2rem, 4vw, 3rem);
  }
  .section-head .lead { margin-top: 0.9rem; }
  .accent { color: var(--accentColor); }

  /* HERO */
  .p-hero {
    position: relative;
    overflow: hidden;
    background: var(--bg);
  }
  .p-hero--pink {
    background:
      radial-gradient(80% 70% at 85% 0%, var(--brand-100) 0%, transparent 55%),
      radial-gradient(70% 60% at 0% 100%, var(--pink-50) 0%, transparent 55%),
      var(--bg);
  }
  .p-hero--gold {
    background:
      radial-gradient(80% 70% at 85% 0%, var(--gold-100) 0%, transparent 55%),
      var(--cream-50);
  }
  .p-hero--navy {
    background:
      radial-gradient(80% 70% at 85% 0%, rgba(44, 62, 80, 0.08) 0%, transparent 55%),
      var(--bg);
  }
  .p-hero-inner {
    display: grid;
    gap: 2rem;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    align-items: center;
  }
  .p-eyebrow {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-bold);
    letter-spacing: 0.12em;
    color: var(--accentColor);
  }
  .p-hero-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.6rem);
    font-weight: var(--fw-bold);
    line-height: 1.4;
    margin-top: 0.8rem;
    color: var(--ink-700);
  }
  .p-hero--pink .p-hero-accent { color: var(--brand-700); }
  .p-hero--gold .p-hero-accent { color: var(--gold-700); }
  .p-hero--navy .p-hero-accent { color: var(--ink-700); }
  .p-hero-lead {
    margin-top: 1.2rem;
    font-size: var(--fs-lead);
    color: var(--text-muted);
    max-width: 36rem;
  }
  .p-hero-badges {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.88rem;
    color: var(--ink-500);
  }
  .p-hero-badges i { color: var(--accentColor); margin-right: 0.35em; }
  .p-hero-actions {
    margin-top: 1.8rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }
  .p-hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    background: var(--ink-900);
    color: #fff;
    border-radius: var(--r-lg);
    padding: 1.1rem 1.6rem;
    max-width: 22rem;
  }
  .p-hero-stats strong {
    font-family: var(--font-serif);
    font-size: 1.7rem;
    color: var(--brand-300);
  }
  .p-hero--gold .p-hero-stats strong { color: var(--gold-300); }
  .p-hero-stats strong span { font-size: 0.85rem; margin-left: 0.1em; }
  .p-hero-stats small { display: block; font-size: 0.7rem; opacity: 0.75; margin-top: 0.15rem; }
  .p-stat-div { width: 1px; height: 32px; background: rgba(255,255,255,0.2); }

  /* PROSE */
  .p-prose p {
    font-size: 0.95rem;
    color: var(--ink-500);
    line-height: 1.9;
    margin-bottom: 1rem;
  }
  .p-prose p:last-child { margin-bottom: 0; }

  /* MECHANISM */
  .p-mech-grid {
    display: grid;
    gap: 1.2rem;
  }
  .p-mech-card {
    background: #fff;
    border: 1px solid var(--cream-300);
    border-radius: var(--r-lg);
    padding: 1.8rem;
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
  }
  .p-mech-card::before {
    content: "";
    position: absolute;
    top: 0; left: 0;
    width: 4px; height: 100%;
    background: var(--brand-gradient);
  }
  .p-hero--gold ~ * .p-mech-card::before,
  :global(.p-hero--gold) + .section .p-mech-card::before {
    background: var(--gold-gradient);
  }
  .p-mech-no {
    font-size: 0.75rem;
    font-weight: var(--fw-bold);
    color: var(--accentColor);
    letter-spacing: 0.1em;
  }
  .p-mech-icon {
    display: inline-flex;
    width: 48px; height: 48px;
    align-items: center; justify-content: center;
    border-radius: var(--r-pill);
    background: var(--brand-gradient);
    color: #fff;
    font-size: 1.2rem;
    margin: 0.6rem 0 0.8rem;
    box-shadow: var(--shadow-brand);
  }
  .p-mech-card h3 {
    font-size: 1.05rem;
    margin-bottom: 0.5rem;
  }
  .p-mech-card p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.75;
  }

  /* FOR WHOM */
  .p-for-grid {
    display: grid;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .p-for-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background: #fff;
    border: 1px solid var(--cream-300);
    border-radius: var(--r-md);
    padding: 1.3rem 1.4rem;
    box-shadow: var(--shadow-sm);
  }
  .p-for-icon {
    flex-shrink: 0;
    width: 42px; height: 42px;
    display: inline-flex;
    align-items: center; justify-content: center;
    border-radius: var(--r-pill);
    background: var(--brand-gradient-soft);
    color: var(--brand-800);
    font-size: 1.1rem;
  }
  .p-for-card h3 {
    font-size: 0.98rem;
    margin-bottom: 0.35rem;
  }
  .p-for-card p {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.65;
  }
  .p-not-for {
    background: var(--cream-100);
    border: 1px solid var(--cream-300);
    border-radius: var(--r-lg);
    padding: 1.5rem;
  }
  .p-not-for h3 {
    font-size: 0.95rem;
    margin-bottom: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.5em;
    color: var(--ink-700);
  }
  .p-not-for h3 i { color: var(--brand-600); }
  .p-not-for ul { display: flex; flex-direction: column; gap: 0.5rem; }
  .p-not-for li {
    display: flex;
    gap: 0.5em;
    font-size: 0.88rem;
    color: var(--ink-500);
  }
  .p-not-for i { color: var(--ink-300); margin-top: 0.15em; flex-shrink: 0; }

  /* PRICING */
  .p-dosage {
    background: #fff;
    border: 1px solid var(--cream-300);
    border-radius: var(--r-md);
    padding: 1.2rem 1.4rem;
    margin-bottom: 1.5rem;
    max-width: 40rem;
    margin-inline: auto;
  }
  .p-dosage h3 {
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.5em;
    color: var(--ink-700);
  }
  .p-dosage h3 i { color: var(--accentColor); }
  .p-dosage p { font-size: 0.88rem; color: var(--ink-500); line-height: 1.7; }
  .table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-radius: var(--r-md);
    border: 1px solid var(--cream-300);
    box-shadow: var(--shadow-sm);
  }
  .price-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.86rem;
    min-width: 580px;
  }
  .price-table thead tr { background: var(--ink-900); }
  .price-table th {
    color: #fff;
    font-weight: var(--fw-bold);
    font-size: 0.8rem;
    padding: 0.8rem 0.9rem;
    text-align: left;
    white-space: nowrap;
  }
  .price-table td {
    padding: 0.85rem 0.9rem;
    border-bottom: 1px solid var(--cream-200);
    background: #fff;
    vertical-align: top;
    color: var(--ink-500);
  }
  .price-table tbody tr:last-child td { border-bottom: none; }
  .drug-cell { display: flex; flex-direction: column; gap: 0.2rem; }
  .drug-name { font-weight: var(--fw-bold); color: var(--ink-700); font-size: 0.9rem; }
  .drug-detail { font-size: 0.74rem; color: var(--brand-700); }
  .drug-note { font-size: 0.72rem; color: var(--ink-400); }
  .price-cell { white-space: nowrap; }
  .term-initial, .term-recur { display: block; font-size: 0.8rem; }
  .term-recur { color: var(--ink-400); }
  .p-payment {
    margin-top: 1.5rem;
    text-align: center;
    max-width: 36rem;
    margin-inline: auto;
  }
  .p-payment h3 {
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
  }
  .p-payment p { font-size: 0.88rem; color: var(--ink-500); line-height: 1.7; }
  .p-payment-note { margin-top: 0.5rem; font-size: 0.8rem !important; color: var(--ink-400) !important; }

  /* STEPS */
  .p-steps {
    display: grid;
    gap: 1rem;
    max-width: 40rem;
    margin-inline: auto;
  }
  .p-step {
    display: flex;
    gap: 1.2rem;
    background: #fff;
    border: 1px solid var(--cream-300);
    border-radius: var(--r-md);
    padding: 1.3rem 1.4rem;
    box-shadow: var(--shadow-sm);
  }
  .p-step-no {
    flex-shrink: 0;
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: var(--fw-bold);
    color: var(--accentColor);
    opacity: 0.7;
  }
  .p-step-head {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-bottom: 0.35rem;
  }
  .p-step-head h3 { font-size: 1rem; }
  .p-step-time {
    font-size: 0.75rem;
    font-weight: var(--fw-bold);
    color: var(--accentColor);
    background: var(--brand-50);
    padding: 0.2em 0.6em;
    border-radius: var(--r-pill);
  }
  .p-step p { font-size: 0.88rem; color: var(--text-muted); line-height: 1.65; }

