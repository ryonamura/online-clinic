---
import "../styles/tokens.css";
// 使用アイコンのみを自己ホストした FontAwesome サブセット（CDN 全部入りの置き換え）。
// 再生成: npm run icons  → scripts/gen-icon-subset.py
import "../styles/fontawesome-subset.css";
import { withBase } from "../lib/links";

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title = "キレイレポオンライン｜オンライン診療",
  description = "GLP-1メディカルダイエット・美容内服・アンチエイジングのオンライン診療。スマホで完結、お薬は最短翌日発送。診察・配送料は別途2,000円（税込）でわかりやすい料金。",
  canonical,
  ogImage = "/ogp.png",
} = Astro.props;

const siteName = "キレイレポオンライン";

// canonical は本番ホスト（kireireport.com/online-clinic）に固定する。
// GitHub Pages（PUBLIC_SITE/PUBLIC_BASE）でビルドしても canonical は常に
// 本番 URL を指すため、複数ホストによる重複コンテンツを防げる。
const CANONICAL_ORIGIN = "https://kireireport.com";
const CANONICAL_BASE = "/online-clinic";
const base = import.meta.env.BASE_URL.replace(/\/$/, ""); // "" または "/online-clinic"
let path = Astro.url.pathname;
if (base && path.startsWith(base)) path = path.slice(base.length); // ビルド時 base 前置きを除去
if (!path.startsWith("/")) path = "/" + path;
if (!path.endsWith("/")) path += "/"; // sitemap と揃えて末尾スラッシュに正規化
const canonicalPath = `${CANONICAL_BASE}${path === "/" ? "/" : path}`;
const canonicalURL = canonical ?? new URL(canonicalPath, CANONICAL_ORIGIN).href;

// base（サブパス配信）を考慮。withBase は base 末尾スラッシュ有無を吸収する。
const faviconHref = withBase("/favicon.svg");
// OG 画像はデプロイ先ホストの絶対URL（実際に配信される場所）を指す。
const ogImageURL = new URL(withBase(ogImage), Astro.site).href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href={faviconHref} type="image/svg+xml" />

    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Fonts: 実際に使用しているウェイトのみ（Sans 400/500/700, Serif 700） -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@700&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <slot />

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      html {
        -webkit-text-size-adjust: 100%;
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        overflow-x: clip;
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-sans);
        font-weight: var(--fw-regular);
        font-size: var(--fs-body);
        line-height: 1.8;
        letter-spacing: 0.02em;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      img,
      svg,
      video {
        max-width: 100%;
        height: auto;
        display: block;
      }
      table {
        max-width: 100%;
      }
      a {
        color: inherit;
        text-decoration: none;
      }

      /* キーボード操作時のフォーカスを明示（アクセシビリティ）。
         ピンクのグラデーションボタン上でも視認できるよう、
         余白を空けたブランド色のリングで統一する。 */
      :focus-visible {
        outline: 3px solid var(--brand-700);
        outline-offset: 2px;
        border-radius: 4px;
      }
      .btn:focus-visible {
        outline-offset: 3px;
      }
      h1,
      h2,
      h3,
      h4 {
        margin: 0;
        line-height: 1.35;
        font-weight: var(--fw-bold);
        color: var(--ink-700);
      }
      p {
        margin: 0;
      }
      ul {
        margin: 0;
        padding: 0;
        list-style: none;
      }

      /* --- shared layout helpers --- */
      .container {
        width: 100%;
        max-width: var(--container);
        margin-inline: auto;
        padding-inline: var(--gutter);
      }
      .container--narrow {
        max-width: var(--container-narrow);
      }
      .section {
        padding-block: var(--section-y);
      }
      /* 交互に敷くクリーム地。セクションの縦リズムを視覚的に定義する。
         各ページで個別定義していたものをここへ集約し、商品・カテゴリ・
         共通コンポーネントで一貫して効くようにする。 */
      .section--cream {
        background: linear-gradient(180deg, var(--cream-50), var(--cream-100));
      }
      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5em;
        font-size: var(--fs-eyebrow);
        font-weight: var(--fw-bold);
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--brand-800);
      }
      .eyebrow::before {
        content: "";
        width: 28px;
        height: 1px;
        background: var(--brand-500);
      }
      .section-title {
        font-size: var(--fs-h2);
        font-weight: var(--fw-bold);
        letter-spacing: 0.04em;
        margin-top: 0.6rem;
      }
      .section-title .accent {
        color: var(--brand-700);
      }
      .lead {
        font-size: var(--fs-lead);
        color: var(--text-muted);
      }

      /* --- buttons --- */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6em;
        padding: 0.95em 1.9em;
        border-radius: var(--r-pill);
        font-weight: var(--fw-bold);
        font-size: 1rem;
        letter-spacing: 0.03em;
        cursor: pointer;
        border: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
        text-align: center;
      }
      .btn--line {
        background: var(--line);
        color: #fff;
        box-shadow: var(--shadow-line);
      }
      .btn--line:hover {
        background: var(--line-dark);
        transform: translateY(-2px);
      }
      .btn--brand {
        background: var(--brand-gradient);
        color: #fff;
        box-shadow: var(--shadow-brand);
      }
      .btn--brand:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-brand-hover);
      }
      .btn--ghost {
        background: transparent;
        color: var(--brand-800);
        border: 1.5px solid var(--brand-400);
      }
      .btn--ghost:hover {
        background: var(--brand-100);
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </body>
</html>
