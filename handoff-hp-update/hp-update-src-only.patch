+  PAYMENT_METHODS,
+  type Plan,
+} from "../data/pricing";
+
+function minInitialYen(...plans: Plan[]): string {
+  const prices: number[] = [];
+  for (const p of plans) {
+    if (p.buyout != null) prices.push(p.buyout);
+    for (const term of [p.m1, p.m3, p.m6]) {
+      if (term?.initial != null) prices.push(term.initial);
+    }
+  }
+  return Math.min(...prices).toLocaleString("ja-JP");
+}
 
